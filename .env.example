# Copiá este archivo como .env.local y completá los valores. .env.local nunca se commitea.
# Las variables VITE_* terminan dentro del bundle del navegador: solo van valores públicos.

# --- TMDB (https://www.themoviedb.org/settings/api) ---
VITE_TMDB_BASE_URL=https://api.themoviedb.org/3/
# Temporal: se elimina cuando entre el proxy /api/tmdb y la key deje de viajar al navegador.
VITE_TMDB_API_KEY=

# Se usa desde el proxy (lado servidor). "API Read Access Token" de TMDB. Sin prefijo VITE_ a propósito.
TMDB_READ_TOKEN=

# --- Firebase (Consola > Configuración del proyecto > Tus apps > App web > SDK setup) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Opcional: Analytics se elimina más adelante en la Fase 2.
VITE_FIREBASE_MEASUREMENT_ID=

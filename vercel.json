{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/og.ts": {
      "includeFiles": "{server/share/fonts/**,src/assets/brand/**,node_modules/@resvg/resvg-wasm/index_bg.wasm}"
    }
  },
  "rewrites": [
    {
      "source": "/__/auth/:path*",
      "destination": "https://peliculed-43e93.firebaseapp.com/__/auth/:path*"
    },
    {
      "source": "/__/firebase/:path*",
      "destination": "https://peliculed-43e93.firebaseapp.com/__/firebase/:path*"
    },
    {
      "source": "/api/tmdb/:path*",
      "destination": "/api/tmdb?path=:path*"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/:kind(pelicula|serie)/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(bot|Bot|facebookexternalhit|WhatsApp|Slack|Embedly|Iframely|vkShare|SkypeUriPreview|Mastodon|Bluesky|Preview|preview).*"
        }
      ],
      "destination": "/api/title-page?kind=:kind&slug=:slug"
    },
    {
      "source": "/((?!api/|__/).*)",
      "destination": "/index.html"
    }
  ]
}
